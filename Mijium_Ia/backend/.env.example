# ==========================================================
# Configuration de l'assistant Mï — copiez ce fichier en ".env"
# et remplissez les valeurs avant de lancer le serveur.
# ==========================================================

# URL du serveur Ollama local (lancé avec `ollama serve`)
OLLAMA_BASE_URL=http://localhost:11434

# Modèle Ollama utilisé pour les réponses de Mï (téléchargé au préalable
# avec `ollama pull llama3`)
OLLAMA_MODEL=llama3

# Secret utilisé pour signer les jetons de connexion (obligatoire, mettez une longue chaîne aléatoire)
JWT_SECRET=changez-moi-en-une-longue-chaine-aleatoire

# Port d'écoute du serveur
PORT=3000

# Origines autorisées à appeler l'API (séparées par des virgules).
# En local avec le frontend servi par ce même serveur : laissez vide ou mettez *
CORS_ORIGIN=*

# --- Facturation (optionnel) ---
# Si STRIPE_SECRET_KEY n'est pas renseignée, le module billing.js fonctionne
# en "mode simulation" : les abonnements sont activés immédiatement sans
# paiement réel, ce qui permet de tester toute l'application sans compte Stripe.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID_PREMIUM=

# Durée de l'essai gratuit, en jours
TRIAL_DURATION_DAYS=7

# Nombre de sessions de guidage autorisées par jour pour un compte gratuit (après l'essai)
FREE_SESSIONS_PER_DAY=3

# Nombre de jours Premium offerts lors d'un parrainage réussi (au parrain ET au filleul)
REFERRAL_BONUS_DAYS=7
