# ==========================================================
# Configuration de l'assistant Mïjium — backend
# ==========================================================

# --- Intelligence artificielle (Google Gemini) ---
# Clé API Gemini — https://aistudio.google.com/api-keys
GEMINI_API_KEY=
# Modèle Gemini utilisé pour les réponses de Mïjium
GEMINI_MODEL=gemini-1.5-flash

# Secret utilisé pour signer les jetons de connexion (obligatoire, longue chaîne aléatoire)
JWT_SECRET=

# Port d'écoute du serveur (Render définit automatiquement sa propre valeur en production)
PORT=3001

# Origines autorisées à appeler l'API (séparées par des virgules).
# En local avec le frontend servi par ce même serveur : laissez * (ou vide)
CORS_ORIGIN=*

# URL publique complète de l'app une fois déployée sur Render
# (ex: https://mijium.onrender.com) — utilisée pour les liens de parrainage
# et comme page de retour après un paiement Stripe.
PUBLIC_APP_URL=

# Dossier de stockage de la base SQLite. Laissez vide en local. Sur Render,
# pointez-le vers le point de montage de votre disque persistant
# (ex: /var/data) pour ne pas perdre les données à chaque redéploiement.
DATA_DIR=

# --- Facturation (Stripe) ---
# Si STRIPE_SECRET_KEY n'est pas renseignée, billing.js fonctionne en "mode
# simulation" : les abonnements sont activés immédiatement sans paiement réel.
# Renseignez les 3 valeurs ci-dessous pour activer les VRAIS paiements Stripe.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID_PREMIUM=
# Optionnel : URLs de retour après paiement. Si vides, dérivées automatiquement
# de PUBLIC_APP_URL (recommandé).
STRIPE_SUCCESS_URL=
STRIPE_CANCEL_URL=

# Durée de l'essai gratuit, en jours
TRIAL_DURATION_DAYS=7

# Nombre de sessions de guidage autorisées par jour pour un compte gratuit (après l'essai)
FREE_SESSIONS_PER_DAY=3

# Nombre de jours Premium offerts lors d'un parrainage réussi (au parrain ET au filleul)
REFERRAL_BONUS_DAYS=7

# --- Administration ---
# Cette adresse e-mail est automatiquement promue au rôle admin (accès
# total, tableau de bord des transactions à /api/admin/*)
ADMIN_EMAIL=anayamite@gmail.com

# Prix Premium (en centimes) utilisé pour journaliser les transactions en
# mode simulation, et devise associée (code ISO 3 lettres, minuscules).
PREMIUM_PRICE_CENTS=999
PREMIUM_CURRENCY=eur
